# Copy to .env and fill in. .env is gitignored.

# LLM provider: "anthropic" (real API, needs ANTHROPIC_API_KEY) or "mock" (offline).
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_TEMPERATURE=0.2
# ANTHROPIC_MAX_TOKENS=1000

# LangSmith tracing (optional; @traceable is a no-op without this)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

# Logging
# LOG_TO_FILE=false

# Triage: min extraction confidence to let the LLM override the submitted department
# DEPARTMENT_CONFIDENCE_THRESHOLD=0.6
